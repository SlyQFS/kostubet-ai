# === Telegram ===
# Токен бота, полученный у @BotFather (обязателен)
TELEGRAM_BOT_TOKEN=123456789:AAYourTokenHere

# === Модель (любой OpenAI-совместимый API) ===
# Эти значения — дефолты. Их можно прямо из Telegram командами
# /set_model, /set_api, /set_key (см. /settings). Сброс к .env — /reset_setting.
# Ключ API. Для локальных серверов (Ollama, LM Studio) можно оставить пустым
LLM_API_KEY=sk-...
# Базовый URL: OpenAI / OpenRouter / локальный сервер
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Память ===
# Путь к файлу базы данных SQLite
DATABASE_PATH=data/memory.db
# Жёсткий лимит размера всей базы (в мегабайтах), по умолчанию 1024 = 1 ГБ
MEMORY_LIMIT_MB=1024
# Сколько токенов последних сообщений помнится на одного пользователя
USER_MEMORY_TOKENS=5000
# Максимальный бюджет токенов для группового чата (при 6+ участниках).
# Прогрессия: 1 участник = USER_MEMORY_TOKENS, 6 участников = MAX_GROUP_MEMORY_TOKENS
MAX_GROUP_MEMORY_TOKENS=40000

# === Доступ ===
# User_id администраторов через запятую; только они могут добавлять и удалять гайды.
# Пусто — управлять гайдами может любой (режим личного бота).
ADMIN_USER_IDS=

# === Чаты ===
# Список chat_id (через запятую), в которых бот активен.
# Поддерживаются суперчаты (группы) и личные чаты. Чтобы узнать chat_id группы,
# добавьте бота в супергруппу и найдите свой/чат в /memory или логах.
# Пусто — бот отвечает в любом чате.
ALLOWED_CHATS=

# === Темы (топики форумов) ===
# Список id тем (через запятую), в которых бот активен. Применяется только к
# супергруппам с включёнными темами (форумам). id темы = id корневого сообщения
# темы (его можно увидеть, переслав сообщение из темы боту, или в логах).
# Пусто — бот работает во всех темах (а также в обычных группах и личке).
# При непустом значении бот отвечает только в перечисленных темах; тема «General»
# и обычные группы/лички этим фильтром не затрагиваются.
ALLOWED_THREADS=

# === Поведение, очередь и защита от перегрузки ===
MAX_REPLY_TOKENS=1500
LLM_TEMPERATURE=0.7
# Максимальное количество параллельных запросов к LLM (очередь FIFO)
MAX_CONCURRENT_REQUESTS=5
# Частотный лимит: максимум запросов к LLM от одного пользователя за окно времени
RATE_LIMIT_REQUESTS=30
# Длина окна частотного лимита в секундах (60 = 1 минута)
RATE_LIMIT_WINDOW_SECS=60
# Системный промпт по умолчанию (можно переопределить через /set_prompt)
# DEFAULT_SYSTEM_PROMPT=

# === Логи ===
RUST_LOG=kostubetai=info,teloxide=warn
