# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token

# --- LLM (OpenAI-совместимый эндпоинт) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
# Список моделей через запятую; первая — активная по умолчанию.
# Переключение в рантайме: /model в ЛС у бота.
LLM_MODELS=gpt-4o-mini,deepseek/deepseek-chat-v3

# --- Доступ ---
# id админов через запятую (ЛС-админка)
ADMINS=
# Вайтлист групп; пусто = разрешены все группы
ALLOWED_CHATS=
# Вайтлист форум-топиков; пусто = разрешены все топики разрешённых чатов
ALLOWED_THREADS=

# --- Пути ---
DB_PATH=data/kostubetai.db
KNOWLEDGE_DIR=knowledge

# --- Лимиты ---
# Скользящее окно истории одного чата/топика, токенов
MESSAGE_WINDOW_TOKENS=4000
# Максимум символов одного мета-блока <user:...>
USER_META_CHARS=600
MAX_REPLY_TOKENS=1200
TEMPERATURE=0.7
# Очередь к LLM
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECS=60

# --- База знаний (Knowledge Base) ---
KNOWLEDGE_TOP_N=4
KNOWLEDGE_THRESHOLD=0.55
KNOWLEDGE_MAX_CHARS=4000
