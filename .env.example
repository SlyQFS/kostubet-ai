# === Telegram ===
# Токен бота, полученный у @BotFather (обязателен)
TELEGRAM_BOT_TOKEN=123456789:AAYourTokenHere

# === Модель (любой OpenAI-совместимый API) ===
# Ключ API. Для локальных серверов (Ollama, LM Studio) можно оставить пустым
LLM_API_KEY=sk-...
# Базовый URL: OpenAI / OpenRouter / локальный сервер
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Память ===
# Путь к файлу базы данных SQLite
DATABASE_PATH=data/memory.db
# Жёсткий лимит размера всей базы (в мегабайтах), по умолчанию 1024 = 1 ГБ
MEMORY_LIMIT_MB=1024
# Сколько токенов последних сообщений помнится на одного пользователя
USER_MEMORY_TOKENS=5000

# === Доступ ===
# User_id администраторов через запятую; только они могут добавлять и удалять гайды.
# Пусто — управлять гайдами может любой (режим личного бота).
ADMIN_USER_IDS=

# === Поведение ===
MAX_REPLY_TOKENS=1500
LLM_TEMPERATURE=0.7

# === Логи ===
RUST_LOG=kostubetai=info,teloxide=warn
